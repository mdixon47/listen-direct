# Public values from Supabase Dashboard → Project Settings → API.
# The publishable key is intentionally safe for browser use because RLS
# authorizes every database request.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_replace_me

# This app relies on user sessions and Row Level Security. It does not require a
# Supabase secret key or legacy service-role key in local or hosting config.
